# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
/sopweave/build/
/sopweave/dist/
.venv/
venv/
env/
*.egg

# ---------- Node / 前端 ----------
node_modules/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 构建产物 / 可执行文件 ----------
*.exe
*.msi
*.dmg
*.app

# ---------- 缓存 ----------
.cache/
.superpowers/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 数据库与运行时数据（含真实业务数据，禁止入库）----------
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
data/
sopweave/data/
**/tmp_runs/
**/app-workspaces/
**/.task_memory/
**/.task_memory/**/dump_*.json

# ---------- 与项目无关的下载素材 ----------
downloads/

# ---------- 测试夹具中的敏感 / 无关文件 ----------
sopweave/test-fixtures/**/storage/
sopweave/test-fixtures/**/game/
sopweave/test-fixtures/**/待处理数据/
sopweave/test-fixtures/**/*.pdf
sopweave/test-fixtures/**/*.docx
sopweave/test-fixtures/**/*.xls
sopweave/test-fixtures/**/*.xlsx
sopweave/test-fixtures/**/__pycache__/

# ---------- 环境变量 / 凭据 ----------
apikey.txt
api-key*.txt
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
client_secret*.json

# ---------- 日志 ----------
*.log
logs/

# ---------- IDE / OS ----------
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store
desktop.ini
