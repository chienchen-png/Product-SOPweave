# =========================================================
#  换行符统一规范（本文件必须提交，不可随意改动）
# ---------------------------------------------------------
#  为什么必须有这个文件：
#  Git 的合并是「按行内容匹配」的。如果同一个文件在不同人的机器上
#  换行符不同（CRLF vs LF），Git 会认为【每一行都变了】，
#  于是报出整文件冲突 —— 明明只改了 3 行，却要面对 800 行冲突。
#
#  把规范写进仓库，就不再依赖每个人的本地 Git 配置，也不依赖
#  编辑器/智能体生成文件时的行为。
#
#  规范：仓库内一律存储 LF；Windows 专属脚本保留 CRLF。
# =========================================================

# 默认：由 Git 自动判定文本文件，并在仓库内规范化为 LF
* text=auto

# ---------- 源代码 / 文档 / 配置 ----------
# 只声明 text（Git 在入库时规范化为 LF），【不】强制工作区换行符。
# → Windows 检出 CRLF、Linux/macOS 检出 LF，各平台都自然。
#
# ⚠️ 不要在这里加 eol=lf：
#    那会迫使 Windows 工作区文件变成 LF，导致编辑器/工具改过的文件
#    在 git status 里显示为「整文件被修改」的假改动（实测：仅换行符
#    差异就会报出 113 增 / 93 删），反而掩盖真实改动。
#    防冲突的关键是「仓库内统一 LF」，这一点 text 已经保证。
*.py        text
*.ts        text
*.tsx       text
*.js        text
*.jsx       text
*.mjs       text
*.cjs       text
*.json      text
*.jsonc     text
*.md        text
*.css       text
*.scss      text
*.html      text
*.htm       text
*.sql       text
*.yml       text
*.yaml      text
*.toml      text
*.ini       text
*.cfg       text
*.txt       text
*.csv       text
*.svg       text

# ---------- 跨平台脚本：必须固定换行符 ----------
# Shell 脚本用 LF（CRLF 会让 bash 报 bad interpreter）
*.sh        text eol=lf

# ---------- Windows 专属脚本：保持 CRLF ----------
# 若改为 LF，cmd.exe 执行 .bat 可能出现异常
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# ---------- 二进制：禁止任何行尾转换（转换会损坏文件）----------
*.xlsx      binary
*.xls       binary
*.xlsm      binary
*.db        binary
*.db-wal    binary
*.db-shm    binary
*.sqlite    binary
*.sqlite3   binary
*.whl       binary
*.egg       binary
*.exe       binary
*.dll       binary
*.so        binary
*.zip       binary
*.tar       binary
*.gz        binary
*.7z        binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.bmp       binary
*.webp      binary
*.pdf       binary
*.docx      binary
*.doc       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary
*.mp4       binary
*.mp3       binary

# ---------- 锁文件：不展示逐行 diff（体积大且无意义）----------
sopweave/frontend/package-lock.json  -diff
